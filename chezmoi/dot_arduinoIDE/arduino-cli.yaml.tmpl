board_manager:
    additional_urls:
        - https://static-cdn.m5stack.com/resource/arduino/package_m5stack_index.json
build_cache:
    compilations_before_purge: 10
    ttl: 720h0m0s
daemon:
    port: "50051"
directories:
    builtin:
        libraries: {{ .chezmoi.homeDir }}/Library/Arduino15/libraries
    data: {{ .chezmoi.homeDir }}/Library/Arduino15
    downloads: {{ .chezmoi.homeDir }}/Library/Arduino15/staging
    user: {{ .chezmoi.homeDir }}/Documents/Arduino
library:
    enable_unsafe_install: false
locale: en
logging:
    file: ""
    format: text
    level: info
metrics:
    addr: :9090
    enabled: true
output:
    no_color: false
sketch:
    always_export_binaries: false
updater:
    enable_notification: true
