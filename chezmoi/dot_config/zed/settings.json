// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "vim_mode": true,
  "ssh_connections": [
    {
      "host": "github",
      "args": [],
      "projects": []
    },
    {
      "host": "UbuntuUtm",
      "args": [],
      "projects": []
    },
    {
      "host": "github.com",
      "args": [],
      "projects": []
    }
  ],
  "languages": {
    "Rust": {
      "inlay_hints": {
        "enabled": true
      },
      "prettier": {
        "allowed": false,
      },
      "always_treat_brackets_as_autoclosed": false,
    },
  },
  "features": {
    "edit_prediction_provider": "copilot",
  },
  "terminal": {
    "font_size": 12.0,
    "font_family": "MesloLGS NF",
  },
  "git_panel": {
    "dock": "left",
    "fallback_branch_name": "",
  },
  "linked_edits": true,
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
}
