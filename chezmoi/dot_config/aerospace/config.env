#!/usr/bin/env bash

# Managed defaults. Put machine-specific overrides in config.local, which is
# intentionally not managed by chezmoi.
: "${AEROSPACE_BIN:=/opt/homebrew/bin/aerospace}"
: "${AEROSPACE_APP_NAME:=AeroSpace}"
: "${AEROSPACE_CONFIG_DIR:=$HOME/.config/aerospace}"
: "${AEROSPACE_MONITOR_CHECK_SCRIPT:=$AEROSPACE_CONFIG_DIR/scripts/check-external-monitor.sh}"
: "${AEROSPACE_STATE_DIR:=${XDG_STATE_HOME:-$HOME/.local/state}/aerospace}"
: "${AEROSPACE_LOG_DIR:=$HOME/Library/Logs/aerospace}"
: "${AEROSPACE_MONITOR_RETRIES:=12}"
: "${AEROSPACE_MONITOR_RETRY_SECONDS:=5}"
: "${AEROSPACE_WINDOW_RETRIES:=180}"
: "${AEROSPACE_WINDOW_RETRY_SECONDS:=2}"
# Workspace 2 starts from an equal split; +688px on the current 3440px
# external display makes Ghostty approximately 7/10 and Chrome 3/10 (7:3).
# Override this in config.local when using another display width.
: "${AEROSPACE_WORKSPACE_2_LEFT_RESIZE_PX:=688}"
: "${AEROSPACE_LEFT_RESIZE_PX:=200}"
: "${AEROSPACE_STAGING_WORKSPACE:=10}"

CHROME_APP_BUNDLE_ID="com.google.Chrome"
CHROME_APP_PATH="/Applications/Google Chrome.app"
CHROME_DATA_DIR="$HOME/Library/Application Support/Google/Chrome"
CHROME_DEFAULT_PROFILE_DIR="Default"
CHROME_PROFILE_4_DIR="Profile 4"

LINE_APP_BUNDLE_ID="jp.naver.line.mac"
DISCORD_APP_BUNDLE_ID="com.hnc.Discord"
GHOSTTY_APP_BUNDLE_ID="com.mitchellh.ghostty"
CHATGPT_APP_BUNDLE_ID="com.openai.codex"
MUSIC_APP_BUNDLE_ID="com.apple.Music"

# These are only fallbacks for a first run where Chrome's session files do not
# contain the active URL. They can be overridden in config.local. A match is
# accepted only when it is unique; ambiguous windows are left untouched.
: "${DEFAULT_WORKSPACE_1_HINTS:=github\.com|docs\.rs|rust-lang\.org}"
: "${DEFAULT_WORKSPACE_2_HINTS:=calendar\.google\.com|mail\.google\.com|gmail\.com}"

export AEROSPACE_BIN AEROSPACE_APP_NAME AEROSPACE_CONFIG_DIR
export AEROSPACE_MONITOR_CHECK_SCRIPT AEROSPACE_STATE_DIR AEROSPACE_LOG_DIR
export AEROSPACE_MONITOR_RETRIES AEROSPACE_MONITOR_RETRY_SECONDS
export AEROSPACE_WINDOW_RETRIES AEROSPACE_WINDOW_RETRY_SECONDS
export AEROSPACE_WORKSPACE_2_LEFT_RESIZE_PX
export AEROSPACE_LEFT_RESIZE_PX AEROSPACE_STAGING_WORKSPACE
export CHROME_APP_BUNDLE_ID CHROME_APP_PATH CHROME_DATA_DIR
export CHROME_DEFAULT_PROFILE_DIR CHROME_PROFILE_4_DIR
export LINE_APP_BUNDLE_ID DISCORD_APP_BUNDLE_ID GHOSTTY_APP_BUNDLE_ID
export CHATGPT_APP_BUNDLE_ID MUSIC_APP_BUNDLE_ID
export DEFAULT_WORKSPACE_1_HINTS DEFAULT_WORKSPACE_2_HINTS
