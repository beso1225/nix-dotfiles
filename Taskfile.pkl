amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.11.0#/Taskfile.pkl"

local strictShellFlags: List<String> = List("-eu", "-o", "pipefail", "-c")

local switchTask = new Task {
  name = "switch"
  description = "Apply nix-darwin configuration"
  cache = false
  shellFlags = strictShellFlags
  params {
    new {
      name = "host"
      type = "string"
      default = "TY"
      description = "darwinConfiguration host name"
    }
  }
  cmd = "sudo darwin-rebuild switch --flake .#$HOST"
}

local updateNixpkgsTask = new Task {
  name = "update-nixpkgs"
  description = "Update only the nixpkgs flake input"
  cache = false
  shellFlags = strictShellFlags
  cmd = """
    nix flake update nixpkgs
    echo "Updated nixpkgs. Run 'pkf run switch' to apply changes."
    """
}

local updateHomebrewTask = new Task {
  name = "update-homebrew"
  description = "Update Homebrew metadata outside of nix-darwin"
  cache = false
  shellFlags = strictShellFlags
  cmd = """
    brew update
    echo "Updated Homebrew. Run 'pkf run switch' to apply changes."
    """
}

local updateAllTask = new Task {
  name = "update-all"
  description = "Update all flake inputs after explicit confirmation"
  cache = false
  shellFlags = strictShellFlags
  params {
    new {
      name = "yes"
      type = "bool"
      default = "false"
      description = "Skip the confirmation prompt"
    }
  }
  cmd = """
    if [ "$YES" != "true" ]; then
      echo "WARNING: This runs 'nix flake update' and may update all flake inputs (including home-manager and nix-darwin)."
      printf "Continue? [y/N] "
      read -r reply
      if [[ ! "$reply" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
      fi
    fi

    nix flake update
    echo "Updated flake inputs. Run 'pkf run switch' to apply changes."
    """
}

local testNeovimTask = new Task {
  name = "test-neovim"
  description = "Run headless Neovim configuration tests"
  cache = false
  shellFlags = strictShellFlags
  inputs {
    "home-manager/nvim/**/*.lua"
    "tests/neovim/**/*.lua"
  }
  cmd = """
    state_dir="${TMPDIR:-/tmp}/nix-dotfiles-neovim-test"
    mkdir -p "$state_dir/state" "$state_dir/cache" "$state_dir/data"
    REPO_ROOT="$PWD" \
      XDG_STATE_HOME="$state_dir/state" \
      XDG_CACHE_HOME="$state_dir/cache" \
      XDG_DATA_HOME="$state_dir/data" \
      NVIM_LOG_FILE="$state_dir/nvim.log" \
      nvim --clean -i NONE --headless -l tests/neovim/moonbit_spec.lua
    """
}

tasks {
  switchTask
  updateNixpkgsTask
  updateHomebrewTask
  updateAllTask
  testNeovimTask
}
